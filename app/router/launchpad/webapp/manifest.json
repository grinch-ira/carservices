{
    "_version": "1.65.0",

    "sap.app": {
        "id": "launchpad",
        "type": "application",
        "title": "Car Service",
        "applicationVersion": {
            "version": "1.0.0"
        }
    },

    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },

    "sap.ui5": {
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {}
            }
        },

        "rootView": {
            "viewName": "launchpad.view.App",
            "type": "XML",
            "async": true,
            "id": "app"
        }
    }
}